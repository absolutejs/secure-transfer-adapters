{
  "name": "@absolutejs/secure-transfer-adapters",
  "private": true,
  "type": "module",
  "workspaces": [
    "local",
    "s3"
  ],
  "scripts": {
    "build": "bun run --filter './*' build",
    "check:package": "bun run --filter './*' check:package",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "test": "bun run --filter './*' test",
    "typecheck": "bun run --filter './*' typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.0"
  }
}
